;; The loop owns this child for its lifetime. It remains in the foreground
;; process group to read the inherited terminal, independently of workers.
!(import! &self utils)
(= (terminal-reader:publish $directory $sequence $line)
   (if (== (str:utf8-error $line) StrUtf8WellFormedV1)
    (let* (($number (text $sequence))
          ($name (str-cat ((str:char-slice "00000000000000000000" 0 (- 20 (str:byte-length $number))) $number ".json")))
          ($path (str-cat ($directory "/" $name)))
          ($temp (str-cat ($directory "/_" $name)))
          (() (fs:write $temp (json:stringify $line)))
          (() (fs:rename $temp $path))) true) false))
(= (terminal-reader:loop $directory $sequence)
   (case (system:read-line)
     ((end_of_file (fs:write (str:concat $directory "/eof") ""))
      ($line (if (is-string $line)
                 (case (collapse (catch (once (terminal-reader:publish $directory $sequence $line))))
                   (((true) (progn (cut) (terminal-reader:loop $directory (+ $sequence 1))))
                    ($failure (fs:write (str:concat $directory "/error") "input publication failed"))))
                 (fs:write (str:concat $directory "/error") (text $line)))))))
!(let* (($directory (car-atom (system:args)))
        (() (fs:write (str:concat $directory "/ready") "")))
   (terminal-reader:loop $directory 0))
