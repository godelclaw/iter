;; Only the isolated numeric-loopback fixture supplies these settings.
!(import! &self (library io))
!(import! &self (library system))
(= (probe:finish $request)
   (let $result (io:wait $request 16000)
     (progn (println! (completed $result))
       (case $result
         (((io:event $request (tcp:connected $connection))
           (let (io:pending $read) (io:submit (tcp:receive $connection))
             (progn
               (println! (read-idle (io:wait $read 50)))
               (let (io:pending $send) (io:submit (tcp:send $connection "PONG :primitive\r\n"))
                 (println! (sent (io:wait $send 1000))))
               (println! (read-ready (io:wait-ready $read 1000)))
               (println! (received (io:wait $read 1000)))
               (println! (consumed (io:poll $read)))
               (let (io:pending $pending) (io:submit (tcp:receive $connection))
                 (progn
                   (println! (pending-idle (io:wait $pending 50)))
                   (println! (cancelled (io:cancel $pending)))
                   (println! (cancel-consumed (io:poll $pending)))))
               (let (io:pending $close) (io:submit (tcp:close $connection))
                 (println! (closed (io:wait $close 1000)))))))
          ((io:idle) (println! (cancelled (io:cancel $request))))
          ($terminal ()))))))
!(let* (($url (system:getenv-or-default "IRC_TEST_URL" "invalid"))
        ($ca (system:getenv-or-default "IRC_TEST_CA" ""))
        ($mode (system:getenv-or-default "IRC_TEST_MODE" "default")))
   (if (== $mode "malformed")
       (println! (refused (collapse (catch (once (io:submit (tcp:connect $url 15000 4096 lines ((ca-file 42)))))))))
       (case (if (== $mode "explicit")
                 (io:submit (tcp:connect $url 15000 4096 lines ((ca-file $ca))))
                 (io:submit (tcp:connect $url 15000 4096 lines)))
         (((io:pending $request) (probe:finish $request))
          ($bad (println! (unexpected $bad)))))))
