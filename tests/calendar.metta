!(import! &self "../lib_calendar.metta")
!(test (calendar:ordinal 1970 1 1) 719163)
!(test (calendar:ordinal 2000 3 1) 730180)
!(test (calendar:naive (CalendarParts 1970 1 1 0 0 0)) 0)
!(test (calendar:naive (CalendarParts 1969 12 31 23 59 59)) -1)
!(test (calendar:leap 1900) false)
!(test (calendar:leap 2000) true)
!(test (calendar:parse "2026-10-28 12:34:56" 4) (CalendarParts 2026 10 28 12 34 56))
!(test (calendar:parse "2026-2-3 4:5:6" 4) (CalendarParts 2026 2 3 4 5 6))
!(test (calendar:parse "2026-02-29 00:00:00" 4) (calendar:failure))
!(test (calendar:parse "2024-02-29 00:00:00" 4) (CalendarParts 2024 2 29 0 0 0))
!(test (calendar:parse "2026-13-01 00:00:00" 4) (calendar:failure))
!(test (calendar:parse "2026-10-28 24:00:00" 4) (calendar:failure))
