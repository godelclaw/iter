!(import! &self "../utils.metta")
(= (call-defaults $kwargs)
   (invoke_dynamic "tests/fixtures/defaults.metta" "run" () $kwargs 5))
!(test (call-defaults (JsonObject ((JsonPair "a" "A")))) (ok "[\"A\", \"B\", null]"))
!(test (call-defaults (JsonObject ((JsonPair "a" "first") (JsonPair "a" "last"))))
       (ok "[\"last\", \"B\", null]"))
!(test (call-defaults (JsonObject ((JsonPair "a" "A") (JsonPair "b" JsonNull) (JsonPair "c" false))))
       (ok "[\"A\", null, false]"))
!(test (call-defaults (JsonObject ())) (error "TypeError: run() missing required arguments: a"))
!(test (call-defaults (JsonObject ((JsonPair "a" "A") (JsonPair "extra" 1))))
       (error "TypeError: run() got unexpected keyword arguments: extra"))
!(test (let (ok $metadata)
            (invoke_dynamic "tests/fixtures/defaults.metta" "__tool_metadata__" () (no-kwargs) 5)
         (json:get $metadata "required"))
       (JsonArray ("a")))
!(test (invoke_dynamic "tests/fixtures/defaults_invalid.metta" "run" ()
                      (JsonObject ((JsonPair "a" "A"))) 5)
       (error "TypeError: defaults contains an undeclared parameter"))
!(test (fs:is-file ".runtime/defaults-bad-ran") false)
!(test (let* (((inop $tool) (tool_metadata "tests/fixtures/defaults.metta" 100 5))
              ($schema (native_tool $tool)))
         (json:get (json:get (json:get $schema "function") "parameters") "required"))
       (JsonArray ("a")))
