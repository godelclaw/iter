;; NAL score updates and the reference's word-boundary error detector.
!(import! &self "lib_context.metta")

(= (rel:directory)
   (system:getenv-or-default "ITER_RELIABILITY_DIR" "transformations/.runtime"))
(= (rel:path) (str:concat (rel:directory) "/tool_reliability.json"))
(= (rel:word $text)
   (if (== $text "") false
     (let $code (car-atom (str:python-codepoints $text))
       (if (== $code 95) true
         (let $category (str:unicode-category $code)
           (or (str:starts-with $category "L") (str:starts-with $category "N")))))))
(= (rel:last-word $text)
   (let $size (str:char-length $text)
     (if (== $size 0) false (rel:word (str:char-slice $text (- $size 1) $size)))))
(= (rel:phrase $text $needle $preceding)
   (case (str:find $text $needle)
     (((TextNotFound $missing) false)
      ($at
       (let* (($before (str:byte-slice $text 0 $at))
              ($end (+ $at (str:byte-length $needle)))
              ($after (str:byte-slice $text $end (str:byte-length $text)))
              ($left (if (== $at 0) $preceding (rel:last-word $before))))
         (if (and (not $left) (not (rel:word $after))) true
           (rel:phrase $after $needle true)))))))
(= (rel:has-error $text)
   (if (not (is-string $text)) (ReliabilityAbort "tool content must be text")
     (let $lower (str:python-lower (ctx:replace (ctx:replace (ctx:replace $text "İ" "i") "ı" "i") "ſ" "s"))
       (or (rel:phrase $text "TIMEOUT" false)
           (is-member true (map-atom ("error" "traceback" "exception" "not found" "invalid" "failed" "timed out")
                             $pattern (rel:phrase $lower $pattern false)))))))

;; Keep decoding failure distinct from the I/O and JSON failures that the
;; Python source deliberately ignores.
(= (rel:load $path)
   (if (not (fs:exists $path)) (JsonObject ())
     (case (fs:read-text-result $path 0 "raw")
       ((("ok" $bytes)
         (case (ctx:decode $bytes)
           (((ContextText $text)
             (case (json:parse-python $text)
               (((JsonPythonErrorV1 JSONDecodeError $message $detail $position $line $column) ReliabilitySkip)
                ((JsonObject $pairs) (JsonObject $pairs))
                ($other (ReliabilityAbort "scores must be a JSON object")))))
            ($bad (ReliabilityAbort "scores must be UTF-8")))))
        ($io ReliabilitySkip)))))
(= (rel:number $value)
   (case $value
     ((true 1) (false 0)
      ($other (if (== (get-type $other) Number) $other (ReliabilityAbort "score field must be numeric"))))))
(= (rel:round $value)
   (let $text (str:format-fixed $value 4)
     (case $text
       (("nan" $value) ("inf" $value) ("-inf" $value)
        ($other (str:string->number $text))))))
(= (rel:revise $f $c $success)
   (case (rel:number $c)
     (((ReliabilityAbort $why) (ReliabilityAbort $why))
      ($confidence
       (case (rel:number $f)
         (((ReliabilityAbort $why) (ReliabilityAbort $why))
          ($frequency
           (let* (($weight (if (< $confidence 1.0) (/ $confidence (- 1 $confidence)) 10000000000.0))
                  ($sum (+ $weight 1.0)))
             (if (or (== $sum 0) (== (+ $sum 1) 0)) (ReliabilityAbort "zero revision denominator")
               (Revised (rel:round (/ (+ (* $weight $frequency) (if $success 1.0 0.0)) $sum))
                        (rel:round (/ $sum (+ $sum 1)))))))))))))
(= (rel:score $score $success)
   (if (not (ctx:object $score)) (ReliabilityAbort "tool score must be an object")
     (case (rel:number (object-get $score "calls" 0))
       (((ReliabilityAbort $why) (ReliabilityAbort $why))
        ($calls
         (case (if (< $calls 1) (Revised (if $success 1.0 0.0) 0.5)
                   (rel:revise (object-get $score "f" JsonNull) (object-get $score "c" JsonNull) $success))
           (((ReliabilityAbort $why) (ReliabilityAbort $why))
            ((Revised $f $c)
             (let $field (if $success "successes" "failures")
               (case (rel:number (object-get $score $field 0))
                 (((ReliabilityAbort $why) (ReliabilityAbort $why))
                  ($count
                   (object-put (object-put (object-put (object-put $score "f" $f) "c" $c)
                                           "calls" (+ $calls 1)) $field (+ $count 1))))))))))))))
(= (rel:save $path $scores)
   (case (json:stringify-python-with $scores ((indent 2)))
     (((JsonPythonErrorV1 $class $message $prefix)
       (progn (fs:write $path $prefix) (ReliabilityAbort $message)))
      ($text (progn (fs:write $path $text) true)))))
(= (rel:update $name $success)
   (if (not (is-string $name)) (ReliabilityAbort "tool name must be text")
     (case (fs:make-directories (rel:directory) 511)
       ((()
         (case (rel:load (rel:path))
           ((ReliabilitySkip true)
            ((ReliabilityAbort $why) (ReliabilityAbort $why))
            ($scores
             (let $initial (JsonObject ((JsonPair "f" 0.5) (JsonPair "c" 0.0) (JsonPair "calls" 0)
                                       (JsonPair "successes" 0) (JsonPair "failures" 0)))
               (case (rel:score (object-get $scores $name $initial) $success)
                 (((ReliabilityAbort $why) (ReliabilityAbort $why))
                  ($score (rel:save (rel:path) (object-put $scores $name $score))))))))))
        ($bad (ReliabilityAbort "cannot create reliability directory"))))))

;; One match per preceding assistant message, not one per context or call id.
(= (rel:calls $calls $id $content)
   (if (== $calls ()) true
     (let ($call $rest) (decons-atom $calls)
       (if (if (ctx:object $call) (== (object-get $call "id" JsonNull) $id) false)
           (let $function (object-get $call "function" (JsonObject ()))
             (if (not (ctx:object $function)) (ReliabilityAbort "function must be an object")
               (let $name (object-get $function "name" "")
                 (if (ctx:truth $name)
                     (case (rel:has-error $content)
                       (((ReliabilityAbort $why) (ReliabilityAbort $why))
                        ($failed (rel:update $name (not $failed))))) true))))
           (rel:calls $rest $id $content)))))
(= (rel:previous $messages $id $content)
   (if (== $messages ()) true
     (let ($message $rest) (decons-atom $messages)
       (case (if (== (object-get $message "role" JsonNull) "assistant")
                 (case (object-get $message "tool_calls" (JsonArray ()))
                   (((JsonArray $calls) (rel:calls $calls $id $content))
                    ((JsonObject $pairs) true)
                    ($other (if (is-string $other) true (ReliabilityAbort "tool calls must be iterable"))))) true)
         ((true (rel:previous $rest $id $content)) ($bad $bad))))))
(= (rel:messages $messages $previous)
   (if (== $messages ()) true
     (let ($message $rest) (decons-atom $messages)
       (if (not (ctx:object $message)) (ReliabilityAbort "message must be an object")
         (let* (($content (object-get $message "content" "")) ($id (object-get $message "tool_call_id" "")))
           (case (if (and (== (object-get $message "role" JsonNull) "tool")
                          (and (ctx:truth $content) (ctx:truth $id)))
                     (rel:previous $previous $id $content) true)
             ((true (rel:messages $rest (append $previous ($message)))) ($bad $bad))))))))
(= (rel:transform $messages $tools)
   (case $messages
     (((JsonArray $items)
       (case (rel:messages $items ())
         ((true ($messages $tools))
          ((ReliabilityAbort $why) (Error "tool reliability" $why)))))
      ($bad (Error "tool reliability" "messages must be an array")))))

(= (rel:pad $text $width)
   (let $missing (- $width (str:char-length $text))
     (if (<= $missing 0) $text
       (str:concat $text (str:byte-slice "                    " 0 $missing)))))
(= (rel:row $name $score)
   (if (not (ctx:object $score)) (ReliabilityAbort "tool score must be an object")
     (case (rel:number (object-get $score "f" JsonNull))
       (((ReliabilityAbort $why) (ReliabilityAbort $why))
        ($f (case (rel:number (object-get $score "c" JsonNull))
              (((ReliabilityAbort $why) (ReliabilityAbort $why))
               ($c
                (if (not (is-member "calls" (object-keys $score))) (ReliabilityAbort "missing calls field")
                  (str:join " " ((rel:pad $name 20) (rel:pad (str:format-fixed $f 4) 8)
                    (rel:pad (str:format-fixed $c 4) 8) (rel:pad (ctx:py-text (object-get $score "calls" JsonNull)) 8)
                    (rel:pad (ctx:py-text (object-get $score "successes" 0)) 8)
                    (rel:pad (ctx:py-text (object-get $score "failures" 0)) 8))))))))))))
(= (rel:rows $names $scores $reversed)
   (if (== $names ()) (ReliabilityLines (list:reverse $reversed))
     (let ($name $rest) (decons-atom $names)
       (case (rel:row $name (object-get $scores $name JsonNull))
         (((ReliabilityAbort $why) (ReliabilityAbort $why))
          ($line (rel:rows $rest $scores (cons-atom $line $reversed))))))))
(= (rel:report)
   (if (not (fs:exists (rel:path))) "No reliability data yet."
     (case (rel:load (rel:path))
       ((ReliabilitySkip "Reliability file corrupted or empty.")
        ((ReliabilityAbort $why) (Error "tool reliability" $why))
        ($scores
         (case (rel:rows (list:sort (object-keys $scores)) $scores ())
           (((ReliabilityAbort $why) (Error "tool reliability" $why))
            ((ReliabilityLines $lines)
             (str:join "\n" (list:append
               ("=== NAL Tool Reliability ==="
                "Tool                 f        c        calls    succ     fail    "
                "------------------------------------------------------------") $lines))))))))))
