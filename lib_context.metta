;; Shared native context-transform helpers. Files and message text remain data.
!(import! &self "utils.metta")
!(import! &self "lib_text.metta")
!(import! &self (library list))

(= (ctx:object $value) (case $value (((JsonObject $pairs) true) ($other false))))
(= (ctx:contains $text $part)
   (case (str:find $text $part) (((TextNotFound $missing) false) ($position true))))
(= (ctx:controls)
   ("[NO ADDITIONAL" "[TASK COMPLETED" "[NO NEW USER" "[TOOL LIMIT" "[MEMORY FOLDER"
    "[OUTPUT TOKEN" "[YOUR PREVIOUS" "[NOT DELIVERED" "[ALARM]"))
(= (ctx:control $text)
   (is-member true (map-atom (ctx:controls) $part (ctx:contains $text $part))))

(= (ctx:decode $bytes)
   (let $decoder (str:utf8-new strict)
     (case (str:utf8-feed $decoder $bytes true)
       (((Utf8DecodedV1 $text $next) (ContextText (text:universal-newlines $text)))
        ($failure ContextAbort)))))
(= (ctx:read $path)
   (case (fs:read-text-result $path 0 "raw")
     ((("missing" $cwd) ContextMissing)
      (("ok" $bytes) (ctx:decode $bytes))
      ($failure ContextAbort))))

(= (ctx:state $path $trim)
   (case (ctx:read $path)
     ((ContextMissing (ContextState () (str:set ())))
      ((ContextText $text)
       (let $keys (list:unique
                    (filter-atom (map-atom (str:split "\n" $text) $line
                                   (if $trim (text:strip $line) $line))
                      $line (not (== $line ""))))
         (ContextState $keys (str:set $keys))))
      ($failure ContextAbort))))

(= (ctx:hash $text)
   (case (str:utf8-error $text)
     ((StrUtf8WellFormedV1 (str:sha256 $text)) ($invalid ContextAbort))))

;; Python's str/repr for the JSON values used in message fields. This is a
;; rendering operation only; the rendered text is never evaluated.
(= (ctx:hex $code $width $tail)
   (if (<= $width 0) $tail
     (let $digit (str:char-slice "0123456789abcdef" (% $code 16) (+ (% $code 16) 1))
       (ctx:hex (floor-math (/ $code 16)) (- $width 1) (str:concat $digit $tail)))))
(= (ctx:repr-code $code $quote)
   (if (== $code 92) "\\\\"
     (if (== $code $quote) (str:concat "\\" (str:from-python-codepoints ($code)))
       (case $code
         ((9 "\\t") (10 "\\n") (13 "\\r")
          ($other
           (let $category (str:unicode-category $code)
             (if (or (== $code 32)
                     (and (not (str:starts-with $category "C")) (not (str:starts-with $category "Z"))))
                 (str:from-python-codepoints ($code))
                 (if (< $code 256) (str:concat "\\x" (ctx:hex $code 2 ""))
                   (if (< $code 65536) (str:concat "\\u" (ctx:hex $code 4 ""))
                     (str:concat "\\U" (ctx:hex $code 8 ""))))))))))))
(= (ctx:quote $text)
   (let* (($quote (if (and (ctx:contains $text "'") (not (ctx:contains $text "\""))) 34 39))
          ($delimiter (str:from-python-codepoints ($quote)))
          ($body (str:join "" (map-atom (str:python-codepoints $text) $code (ctx:repr-code $code $quote)))))
     (str:join "" ($delimiter $body $delimiter))))
(= (ctx:py-text $value)
   (if (is-string $value) $value (ctx:py-repr $value)))
(= (ctx:py-repr $value)
   (case $value
     ((JsonNull "None") (true "True") (false "False")
      ((JsonArray $items) (str:join "" ("[" (str:join ", " (map-atom $items $item (ctx:py-repr $item))) "]")))
      ((JsonObject $pairs)
       (str:join "" ("{" (str:join ", "
         (map-atom (list:unique (object-keys $value)) $key
           (str:join "" ((ctx:quote $key) ": " (ctx:py-repr (object-get $value $key JsonNull)))))) "}")))
      ($scalar
       (if (is-string $scalar) (ctx:quote $scalar)
         (case (json:stringify-python $scalar)
           (("NaN" "nan") ("Infinity" "inf") ("-Infinity" "-inf") ($text $text))))))))

(= (ctx:event $key-text $line)
   (case (ctx:hash $key-text)
     ((ContextAbort ContextAbort) ($hash (ContextEvents ((ContextEvent $hash $line)))))))

(= (ctx:plain-message $message)
   (if (not (ctx:object $message)) (ContextEvents ())
     (let* (($role (object-get $message "role" "unknown")) ($content (object-get $message "content" "")))
       (if (if (is-string $content) (not (== (text:strip $content) "")) false)
           (if (and (== $role "user") (ctx:control $content)) (ContextEvents ())
             (ctx:event $content (str:join "" ("[" (ctx:py-text $role) "] " $content))))
           (ContextEvents ())))))

(= (ctx:send-arguments $arguments)
   (case (json:parse-python $arguments)
     (((JsonPythonErrorV1 JSONDecodeError $message $detail $pos $line $column) (ContextEvents ()))
      ((JsonObject $pairs)
       (let $line (str:join "" ("[send -> " (ctx:py-text (object-get (JsonObject $pairs) "channel" ""))
                               "] " (ctx:py-text (object-get (JsonObject $pairs) "content" ""))))
         (ctx:event $line $line)))
      ($bad ContextAbort))))
(= (ctx:send-one $call)
   (if (not (ctx:object $call)) (ContextEvents ())
     (let $function (object-get $call "function" (JsonObject ()))
       (if (not (ctx:object $function)) ContextAbort
         (if (== (object-get $function "name" JsonNull) "send")
             (ctx:send-arguments (object-get $function "arguments" "{}")) (ContextEvents ()))))))
(= (ctx:send-calls $calls $reversed)
   (if (== $calls ()) (ContextEvents (list:reverse $reversed))
     (let ($call $rest) (decons-atom $calls)
       (case (ctx:send-one $call)
         (((ContextEvents $events) (ctx:send-calls $rest (list:append (list:reverse $events) $reversed)))
          ($bad ContextAbort))))))

(= (ctx:transcript-message $message)
   (if (not (ctx:object $message)) (ContextEvents ())
     (let* (($role (object-get $message "role" "unknown")) ($content (object-get $message "content" "")))
       (if (== $role "user")
           (if (if (is-string $content) (and (not (== (text:strip $content) "")) (not (ctx:control $content))) false)
               (ctx:event $content $content) (ContextEvents ()))
           (if (== $role "assistant")
               (case (object-get $message "tool_calls" (JsonArray ()))
                 (((JsonArray $calls) (ctx:send-calls $calls ()))
                  ((JsonObject $pairs) (ContextEvents ()))
                  ($other (if (is-string $other) (ContextEvents ()) ContextAbort))))
               (ContextEvents ()))))))

(= (ctx:collect $mode $messages $reversed)
   (if (== $messages ()) (ContextEvents (list:reverse $reversed))
     (let ($message $rest) (decons-atom $messages)
       (case (if (== $mode transcript) (ctx:transcript-message $message) (ctx:plain-message $message))
         (((ContextEvents $events)
           (ctx:collect $mode $rest (list:append (list:reverse $events) $reversed)))
          ($bad ContextAbort))))))

(= (ctx:write-window $mode $events $previous $log-path $state-path)
   (let* (($fresh (filter-atom $events $event
                    (let (ContextEvent $hash $line) $event (not (str:is-set-member $previous $hash)))))
          ($data (str:join "" (map-atom $fresh $event (let (ContextEvent $hash $line) $event (str:concat $line "\n")))))
          ($written (if (and (== $mode transcript) (== $fresh ())) () (fs:append-text $log-path $data))))
     (case $written
       ((() (fs:write $state-path
               (str:join "" (map-atom (list:sort (list:unique (map-atom $events $event
                                  (let (ContextEvent $hash $line) $event $hash)))) $hash (str:concat $hash "\n")))))
        ($failure ContextAbort)))))

(= (ctx:log-transform $mode $messages $tools $log-path $state-path)
   (progn
     (case $messages
       (((JsonArray $items)
         (case (ctx:state $state-path true)
           (((ContextState $keys $previous)
             (case (ctx:collect $mode $items ())
               (((ContextEvents $events) (ctx:write-window $mode $events $previous $log-path $state-path))
                ($bad ContextAbort))))
            ($bad ContextAbort))))
        ($bad ContextAbort)))
     ($messages $tools)))

(= (ctx:truth $value)
   (case $value
     ((JsonNull false) (false false) (true true)
      ((JsonArray $items) (not (== $items ())))
      ((JsonObject $pairs) (not (== $pairs ())))
      ($scalar (if (is-string $scalar) (not (== $scalar "")) (not (== $scalar 0)))))))
(= (ctx:replace $text $old $new) (str:join $new (str:split $old $text)))
(= (ctx:history-escape $text)
   (let* (($slashes (ctx:replace $text "\\" "\\\\"))
          ($quotes (ctx:replace $slashes "\"" "\\\"")))
     (ctx:replace $quotes "\n" " ")))
(= (ctx:history-content $content $prefix $label)
   (if (ctx:truth $content)
       (if (is-string $content)
           (ContextEvents ((ContextEvent (str:concat $prefix $content)
                              (str:concat $label (ctx:history-escape $content)))))
           ContextAbort)
       (ContextEvents ())))
(= (ctx:history-call $call)
   (if (not (ctx:object $call)) (ContextEvents ())
     (let $function (object-get $call "function" (JsonObject ()))
       (if (not (ctx:object $function)) ContextAbort
         (let* (($name (object-get $function "name" "")) ($arguments (object-get $function "arguments" "{}")))
           (if (and (is-string $name) (is-string $arguments))
               (ContextEvents ((ContextEvent (str:join "" ("t:" $name " " $arguments))
                                  (str:join "" ("TOOL_CALL: " $name " " (ctx:history-escape $arguments))))))
               ContextAbort))))))
(= (ctx:history-calls $calls $reversed)
   (if (== $calls ()) (ContextEvents (list:reverse $reversed))
     (let ($call $rest) (decons-atom $calls)
       (case (ctx:history-call $call)
         (((ContextEvents $events) (ctx:history-calls $rest (list:append (list:reverse $events) $reversed)))
          ($bad ContextAbort))))))
(= (ctx:history-assistant $message $content)
   (case (ctx:history-content $content "a:" "ASSISTANT: ")
     (((ContextEvents $head)
       (case (object-get $message "tool_calls" (JsonArray ()))
         (((JsonArray $calls)
           (case (ctx:history-calls $calls ())
             (((ContextEvents $tail) (ContextEvents (list:append $head $tail)))
              ($bad ContextAbort))))
          ((JsonObject $pairs) (ContextEvents $head))
          ($other (if (is-string $other) (ContextEvents $head) ContextAbort)))))
      ($bad ContextAbort))))
(= (ctx:history-message $message)
   (if (not (ctx:object $message)) ContextAbort
     (let* (($role (object-get $message "role" "unknown")) ($content (object-get $message "content" "")))
       (case $role
         (("user" (ctx:history-content $content "u:" "HUMAN_MESSAGE: "))
          ("assistant" (ctx:history-assistant $message $content))
          ("tool" (ctx:history-content $content "r:" "TOOL_RESULT: "))
          ($other (ContextEvents ())))))))
(= (ctx:history-events $messages $reversed)
   (if (== $messages ()) (ContextEvents (list:reverse $reversed))
     (let ($message $rest) (decons-atom $messages)
       (case (ctx:history-message $message)
         (((ContextEvents $events) (ctx:history-events $rest (list:append (list:reverse $events) $reversed)))
          ($bad ContextAbort))))))

;; A private space tracks first occurrences in this one call, matching the
;; reference's immediate set insertion. It is not a persistent store.
(= (ctx:history-fresh $events $previous $seen $reversed)
   (if (== $events ()) (list:reverse $reversed)
     (let* ((($event $rest) (decons-atom $events)) ((ContextEvent $key $line) $event))
       (if (or (str:is-set-member $previous $key)
               (not (== (collapse (match $seen (seen $key) true)) ())))
           (ctx:history-fresh $rest $previous $seen $reversed)
           (let $added (add-atom $seen (seen $key))
             (ctx:history-fresh $rest $previous $seen (cons-atom $event $reversed)))))))
(= (ctx:history-write $events $previous $history-path $state-path $stamp)
   (let* (($seen (new-space))
          ($fresh (ctx:history-fresh $events $previous $seen ()))
          ($text (str:join "" (map-atom $fresh $event
                   (let (ContextEvent $key $line) $event (str:join "" ("(\"" $stamp "\" \"" $line "\")\n")))))))
     (case (fs:append-text $history-path $text)
       ((()
         (case (fs:write $state-path
                 (str:join "\n" (list:sort (list:unique (map-atom $events $event
                                    (let (ContextEvent $key $line) $event $key))))))
           ((() true) ($failure (Error "history" "cannot write state")))))
        ($failure (Error "history" "cannot append history"))))))
(= (ctx:history-transform $messages $tools $history-path $state-path $stamp)
   (case $messages
     (((JsonArray $items)
       (case (ctx:state $state-path false)
         (((ContextState $keys $previous)
           (case (ctx:history-events $items ())
             (((ContextEvents $events)
               (case (ctx:history-write $events $previous $history-path $state-path $stamp)
                 ((true ($messages $tools)) ($failure $failure))))
              ($bad (Error "history" "invalid message or tool-call fields")))))
          ($bad (Error "history" "cannot read state")))))
      ($bad (Error "history" "messages must be a JSON array")))))
