;; Fresh workers exchange atomic files with one native, detached IRC daemon.
;; Only connect/read-line/send-line/close below touch the native TCP provider.
(= (irc:env $name $default) (system:getenv-or-default $name $default))
(= (irc:root) (irc:env "ITER_IRC_RUNTIME" "channels/.runtime/irc"))
(= (irc:path $name) (str-cat ((irc:root) "/" $name)))
(= (irc:host-setting) (irc:env "ITER_IRC_HOST" "irc.quakenet.org"))
(= (irc:scheme)
   (if (str:starts-with (irc:host-setting) "tls://") "tls"
     (if (str:starts-with (irc:host-setting) "tcp://") "tcp" (irc:env "ITER_IRC_SCHEME" "tcp"))))
(= (irc:host)
   (if (or (str:starts-with (irc:host-setting) "tls://") (str:starts-with (irc:host-setting) "tcp://"))
       (str:char-slice (irc:host-setting) 6 (str:char-length (irc:host-setting))) (irc:host-setting)))
(= (irc:port) (irc:env "ITER_IRC_PORT" (if (== (irc:scheme) "tls") "6697" "6667")))
(= (irc:url) (str-cat ((irc:scheme) "://" (irc:host) ":" (irc:port))))
(= (irc:nick) (irc:env "ITER_IRC_NICK" "Iter"))
(= (irc:channel) (irc:env "ITER_IRC_CHANNEL" "##metta"))
;; Two distinct defaults distinguish ABSENT from an explicitly empty setting.
(= (irc:ca)
   (if (== (irc:env "ITER_IRC_CA_FILE" "absent-a") (irc:env "ITER_IRC_CA_FILE" "absent-b"))
       (irc:env "ITER_IRC_CA_FILE" "") none))
(= (irc:idle-ns) (* (str:string->number (irc:env "ITER_IRC_IDLE_MINUTES" "5")) 60000000000))
(= (irc:error $why) (Error IRC $why))
(= (irc:clean $text)
   (and (== (str:utf8-error $text) StrUtf8WellFormedV1)
        (== (size-atom (filter-atom (str:codepoints $text) $c
          (or (== $c "\r") (or (== $c "\n") (== $c (str:from-codepoints (0))))))) 0)))
(= (irc:alphabet $text $extra)
   (and (> (str:byte-length $text) 0)
        (== (size-atom (filter-atom (str:codepoints $text) $c
          (not (or (str:is-all-in alnum $c) (str:is-set-member (str:set (str:codepoints $extra)) $c))))) 0)))
(= (irc:config)
   (and (or (== (irc:scheme) "tcp") (== (irc:scheme) "tls"))
     (and (and (str:is-all-in digit (irc:port)) (and (> (str:byte-length (irc:port)) 0) (<= (str:byte-length (irc:port)) 5)))
       (and (and (> (str:string->number (irc:port)) 0) (<= (str:string->number (irc:port)) 65535))
         (and (and (irc:alphabet (irc:host) ".-") (<= (str:byte-length (irc:host)) 253))
           (and (and (irc:alphabet (irc:nick) "_-[]{}\\^`|") (<= (str:byte-length (irc:nick)) 24))
             (and (str:is-initial-in alpha (irc:nick))
               (and (and (irc:alphabet (irc:channel) "#&+!_-.") (<= (str:byte-length (irc:channel)) 64))
                 (and (or (str:starts-with (irc:channel) "#") (str:starts-with (irc:channel) "&"))
                   (and (and (> (str:byte-length (irc:root)) 0) (irc:clean (irc:root)))
                     (and (> (irc:idle-ns) 0)
                       (if (== (irc:ca) none) true
                         (and (== (irc:scheme) "tls")
                           (and (and (> (str:byte-length (irc:ca)) 0) (irc:clean (irc:ca)))
                             (and (fs:is-file (irc:ca)) (fs:access (irc:ca) ("read")))))))))))))))))
(= (irc:config-ok) (== (collapse (catch (once (irc:config)))) (true)))

;; Completion ownership: idle retains a request; a terminal event consumes it.
;; Connection state is set ONLY by tcp:connected, never by a failed request ID.
(= (irc:connect $url)
   (progn (change-state! &irc:connection none)
     (case (if (== (irc:ca) none)
               (io:submit (tcp:connect $url 15000 8192 lines))
               (io:submit (tcp:connect $url 15000 8192 lines ((ca-file (irc:ca))))))
       (((io:pending $request)
         (case (io:wait $request 16000)
           (((io:event $request (tcp:connected $connection))
             (progn (change-state! &irc:connection $connection) true))
            ((io:idle) (progn (io:cancel $request) false))
            ($terminal false))))
        ($failure false)))))
(= (irc:read-line $connection $timeout)
   (let $request (if (== (get-state &irc:reader) none)
                     (case (io:submit (tcp:receive $connection))
                       (((io:pending $new) (progn (change-state! &irc:reader $new) $new)) ($bad none)))
                     (get-state &irc:reader))
     (if (== $request none) (ended)
       (case (io:wait $request $timeout)
         (((io:idle) (idle))
          ((io:event $request (tcp:received $connection $line))
           (progn (change-state! &irc:reader none) (line $line)))
          ($terminal (progn (change-state! &irc:reader none) (ended))))))))
(= (irc:send-line $connection $line)
   (if (and (irc:clean $line) (<= (+ (str:byte-length $line) 2) 512))
     (case (io:submit (tcp:send $connection (str:concat $line "\r\n")))
       (((io:pending $request)
         (case (io:wait $request 1000)
           (((io:event $request (tcp:sent $connection)) true)
            ((io:idle) (progn (io:cancel $request) false)) ($terminal false))))
        ($bad false))) false))
(= (irc:close)
   (progn
     (if (== (get-state &irc:reader) none) true (io:cancel (get-state &irc:reader)))
     (change-state! &irc:reader none)
     (if (== (get-state &irc:connection) none) true
       (case (io:submit (tcp:close (get-state &irc:connection)))
         (((io:pending $request)
           (case (io:wait $request 1000)
             (((io:idle) (io:cancel $request)) ($terminal true)))) ($bad false))))
     (change-state! &irc:connection none)))

;; All state lives in one trusted private runtime on one filesystem.
(= (irc:directories)
   (let $results (map-atom (inbox outbox uncertain written) $name (fs:make-directories (irc:path $name) 448))
     (if (== $results (() () () ())) true (irc:error (str-cat ("mkdir: " $results))))))
(= (irc:atomic $path $content)
   (let* (($temp (str-cat ($path "_" (system:uuid4-hex))))
          (() (fs:write $temp $content)) (() (fs:rename $temp $path))) true))
(= (irc:lock $name $mode)
   (let $owner (fs:open-write (irc:path $name) ("create") 384)
     (case (fs:lock $owner $mode)
       ((fs:locked (owned $owner))
        (fs:held (progn (fs:close $owner) busy))
        ($bad (progn (fs:close $owner) (irc:error (str-cat ("lock: " $bad)))))))))
(= (irc:unlocked $owner $results)
   (progn (fs:close $owner)
     (case $results ((($value) $value) ($bad (irc:error (str-cat ("operation failed: " $bad))))))))
(= (irc:running)
   (case (irc:lock "daemon.lock" exclusive-nowait)
     ((busy true) ((owned $owner) (progn (fs:close $owner) false)) ($bad $bad))))
(= (irc:number-file $name $default)
   (if (fs:is-file (irc:path $name)) (str:string->number (fs:read-text (irc:path $name))) $default))
(= (irc:files $directory)
   (map-atom (sort-atom (filter-atom (fs:entries $directory) $name
     (and (== (str:byte-length $name) 53)
       (and (str:is-all-in digit (str:char-slice $name 0 20))
         (and (== (str:char-slice $name 20 21) "-") (str:is-all-in xdigit (str:char-slice $name 21 53)))))))
     $name (str-cat ($directory "/" $name))))
(= (irc:base $path) (let $parts (str:split "/" $path) (index-atom $parts (- (size-atom $parts) 1))))
(= (irc:pad-ns $ns)
   (let $value (text $ns) (str:concat (str:char-slice "00000000000000000000" 0 (- 20 (str:byte-length $value))) $value)))
;; A locked logical nanosecond stamp clamps ties/regressions to last+1.
;; Concurrent CALL arrival order is unspecified; publication lock order wins.
(= (irc:publish-owned $directory $content)
   (let* (($now (system:monotonic-ns)) ($last (irc:number-file "order.ns" 0))
          ($stamp (if (> $now $last) $now (+ $last 1)))
          ($id (str-cat ((irc:pad-ns $stamp) "-" (system:uuid4-hex))))
          ($temp (str-cat ($directory "/_" $id)))
          (() (fs:write $temp $content))
          (true (irc:atomic (irc:path "order.ns") (text $stamp)))
          (() (fs:rename $temp (str-cat ($directory "/" $id))))) $id))
(= (irc:publish $directory $content)
   (let (owned $owner) (irc:lock "publish.lock" exclusive)
     (irc:unlocked $owner (collapse (catch (once (irc:publish-owned $directory $content)))))))
(= (irc:take $path)
   (let $claim (str-cat ((irc:path "inbox") "/_claim-" (system:uuid4-hex)))
     (case (fs:rename $path $claim)
       ((() (let $content (fs:read-text $claim) (progn (fs:remove $claim) $content))) ($lost "")))))

;; Retry metadata is reserved BEFORE connecting, under control.lock. The
;; daemon lock excludes another connector even while a connect is pending.
(= (irc:delay $failures) (if (>= $failures 8) 180 (if (<= $failures 1) 2 (* 2 (irc:delay (- $failures 1))))))
(= (irc:retry)
   (if (fs:is-file (irc:path "retry.json"))
       (let (JsonArray ($failures $until $delay)) (json:parse (fs:read-text (irc:path "retry.json")))
         ($failures $until $delay)) (0 0 0)))
(= (irc:retry-write $failures $until $delay)
   (irc:atomic (irc:path "retry.json") (json:stringify (JsonArray ($failures $until $delay)))))
(= (irc:reserve $now)
   (let ($failures $until $old-delay) (irc:retry)
     (if (< $now $until) false
       (let* (($next (+ $failures 1)) ($delay (irc:delay $next))
              (true (irc:retry-write $next (+ $now (* $delay 1000000000)) $delay))
              (true (irc:atomic (irc:path "attempt.ns") (text $now)))) true))))
(= (irc:failed $now)
   (let* ((($failures $until $old-delay) (irc:retry))
          ($count (if (<= $failures 0) 1 $failures)) ($delay (irc:delay $count)))
     (irc:retry-write $count (+ $now (* $delay 1000000000)) $delay)))
(= (irc:last-receive) (irc:number-file "receive.ns" (irc:number-file "origin.ns" 0)))
(= (irc:recent $now) (let $last (irc:last-receive) (and (>= $now $last) (< (- $now $last) (irc:idle-ns)))))
(= (irc:started $left)
   (if (irc:running) true
     (if (<= $left 0) false (progn (sleep 0.01) (irc:started (- $left 1))))))
(= (irc:spawn)
   (let $child (proc:spawn ((cetta) "--lang" "petta" "--no-results" "utils.metta" "channels/irc.metta" "--irc-daemon")
                           ((lifetime detached) (stdout null) (stderr null)))
     (progn (proc:close $child) (irc:started 40))))
(= (irc:ensure-owned $receiving)
   (let $now (system:monotonic-ns)
     (progn
       (if (fs:is-file (irc:path "origin.ns")) true (irc:atomic (irc:path "origin.ns") (text $now)))
       (if $receiving (irc:atomic (irc:path "receive.ns") (text $now)) true)
       (if (irc:running) true
         (let ($failures $until $delay) (irc:retry)
           (if (and (>= $now $until) (irc:recent $now)) (irc:spawn) true))))))
(= (irc:ensure $receiving $left)
   (case (irc:lock "control.lock" exclusive-nowait)
     (((owned $owner) (irc:unlocked $owner (collapse (catch (once (irc:ensure-owned $receiving))))))
      (busy (if (<= $left 0) (irc:error "Startup lock busy")
              (progn (sleep 0.01) (irc:ensure $receiving (- $left 1))))) ($bad $bad))))
(= (irc:expired)
   (case (irc:lock "control.lock" exclusive-nowait)
     (((owned $owner) (irc:unlocked $owner (collapse (catch (once (not (irc:recent (system:monotonic-ns))))))))
      (busy false) ($bad $bad))))

;; Split CR/LF, then scalar-boundary chunks counting prefix AND CRLF in 512.
(= (irc:fit $text $budget $low $high)
   (if (>= $low $high) $low
     (let $middle (floor-math (/ (+ (+ $low $high) 1) 2))
       (if (<= (str:byte-length (str:char-slice $text 0 $middle)) $budget)
           (irc:fit $text $budget $middle $high) (irc:fit $text $budget $low (- $middle 1))))))
(= (irc:chunks $text $budget)
   (if (== $text "") ()
     (let $count (irc:fit $text $budget 0 (str:char-length $text))
       (cons-atom (str:char-slice $text 0 $count)
         (irc:chunks (str:char-slice $text $count (str:char-length $text)) $budget)))))
(= (irc:prefix) (str-cat ("PRIVMSG " (irc:channel) " :")))
(= (irc:frames $content)
   (foldl-atom (str:split "\n" (str:join "\n" (str:split "\r" $content))) () $acc $line
     (append $acc (irc:chunks $line (- 510 (str:byte-length (irc:prefix)))))))
(= (receive)
   (if (irc:config-ok)
     (let* ((true (irc:directories)) (true (irc:ensure true 40)))
       (str:join "\n" (filter-atom (map-atom (irc:files (irc:path "inbox")) $path (irc:take $path))
                                  $message (not (== $message ""))))) (irc:error "Invalid IRC configuration")))
(= (send $content)
   (if (and (irc:config-ok) (is-string $content))
     (if (and (<= (str:byte-length $content) 65536)
           (and (== (str:utf8-error $content) StrUtf8WellFormedV1)
             (not (str:is-set-member (str:set (str:codepoints $content)) (str:from-codepoints (0))))))
       (let* ((true (irc:directories))
              ($id (irc:publish (irc:path "outbox") (json:stringify (JsonArray (irc:frames $content))))))
         (if (is-string $id)
           (let $startup (irc:ensure false 40)
             (str-cat ("QUEUED locally (not server delivery): " $id "; daemon: " $startup)))
           (irc:error (str-cat ("Spool publication failed: " $id)))))
       (irc:error "Content must be valid UTF-8, no NUL, at most 65536 bytes"))
     (irc:error "Invalid IRC configuration or non-string content")))

;; Wire input is inert text. Metadata labels cannot be supplied by the body.
(= (irc:note $message) (let $id (irc:publish (irc:path "inbox") $message) (is-string $id)))
(= (irc:incoming $line)
   (let* (($sections (str:split " :" $line)) ($words (str:split-whitespace (car-atom $sections))))
     (if (str:starts-with $line "PING ")
       (irc:send-line (get-state &irc:connection) (str-cat ("PONG " (str:char-slice $line 5 (str:char-length $line)))))
       (if (< (size-atom $words) 2) true
         (case (index-atom $words 1)
           (("001" (if (get-state &irc:joined) true
             (if (irc:send-line (get-state &irc:connection) (str-cat ("JOIN " (irc:channel))))
               (progn (change-state! &irc:joined true) (irc:retry-write 0 0 0)
                 (irc:note (str-cat ("[IRC status] 001 received; JOIN written locally for " (json:stringify (irc:channel)))))) false)))
            ("433" (let $next (+ (get-state &irc:nick-attempt) 1)
              (progn (change-state! &irc:nick-attempt $next)
                (if (> $next 8) false
                  (irc:send-line (get-state &irc:connection) (str-cat ("NICK " (irc:nick) "_" $next)))))))
            ("PRIVMSG" (if (and (>= (size-atom $words) 3) (> (size-atom $sections) 1))
              (let* (($prefix (car-atom $words)) ($target (index-atom $words 2))
                     ($sender (car-atom (str:split "!" (str:char-slice $prefix 1 (str:char-length $prefix)))))
                     ($kind (if (or (str:starts-with $target "#") (str:starts-with $target "&")) "channel" "private")))
                (irc:note (str-cat ("[IRC " $kind " target=" (json:stringify $target) " from=" (json:stringify $sender) "] "
                                     (str:join " :" (cdr-atom $sections)))))) true))
            ($other true)))))))

;; Burst four, then refill one token per two REAL seconds, capacity four.
;; Read waits service controls independently; no polling spin or test timing.
(= (irc:pace $now)
   (let* (($last (get-state &irc:pace-ns)) ($earned (floor-math (/ (- $now $last) 2000000000)))
          ($tokens (+ (get-state &irc:tokens) $earned)))
     (progn (change-state! &irc:tokens (if (> $tokens 4) 4 $tokens))
       (change-state! &irc:pace-ns (if (>= $tokens 4) $now (+ $last (* $earned 2000000000))))
       (> (get-state &irc:tokens) 0))))
(= (irc:claim)
   (let $files (irc:files (irc:path "outbox"))
     (if (== $files ()) true
       (let* (($source (car-atom $files)) ($dest (str-cat ((irc:path "uncertain") "/" (irc:base $source))))
              (() (fs:rename $source $dest))
              ((JsonArray $frames) (json:parse (fs:read-text $dest))))
         (progn (change-state! &irc:outgoing ($dest $frames)) true)))))
(= (irc:write-frame $path $frames)
   (if (== $frames ())
     (let () (fs:rename $path (str-cat ((irc:path "written") "/" (irc:base $path))))
       (progn (change-state! &irc:outgoing none) true))
     (if (irc:pace (system:monotonic-ns))
       (if (irc:send-line (get-state &irc:connection) (str-cat ((irc:prefix) (car-atom $frames))))
         (progn (change-state! &irc:tokens (- (get-state &irc:tokens) 1))
           (change-state! &irc:outgoing ($path (cdr-atom $frames))) true) false) true)))
(= (irc:outbound)
   (if (get-state &irc:joined)
     (progn (if (== (get-state &irc:outgoing) none) (irc:claim) true)
       (case (get-state &irc:outgoing) ((none true) (($path $frames) (irc:write-frame $path $frames))))) true))
(= (irc:serve)
   (if (irc:expired) idle-exit
     (let $input (irc:read-line (get-state &irc:connection) 100)
       (if (case $input (((idle) true) ((line $line) (irc:incoming $line)) ($ended false)))
         (if (irc:outbound) (progn (cut) (irc:serve)) false) false))))
(= (irc:session)
   (let (owned $control) (irc:lock "control.lock" exclusive)
     (if (irc:unlocked $control (collapse (catch (once (irc:reserve (system:monotonic-ns))))))
       (if (irc:connect (irc:url))
         (if (and (irc:send-line (get-state &irc:connection) (str-cat ("NICK " (irc:nick))))
                  (irc:send-line (get-state &irc:connection) (str-cat ("USER " (irc:nick) " 0 * :Iter Agent"))))
             (irc:serve) false) false) deferred)))
(= (irc:daemon-owned $owner)
   (progn
     (change-state! &irc:connection none) (change-state! &irc:reader none)
     (change-state! &irc:outgoing none) (change-state! &irc:joined false)
     (change-state! &irc:nick-attempt 0) (change-state! &irc:tokens 4)
     (change-state! &irc:pace-ns (system:monotonic-ns))
     (fs:write (irc:path "pid") (text (system:pid)))
     (let $outcome (collapse (catch (once (irc:session))))
       (progn
         (if (or (== $outcome (idle-exit)) (== $outcome (deferred))) true
           (let (owned $control) (irc:lock "control.lock" exclusive)
             (irc:unlocked $control (collapse (catch (once (irc:failed (system:monotonic-ns))))))))
         (collapse (catch (once (irc:close))))
         (fs:write (irc:path "ended.txt") (text $outcome))
         (fs:close $owner) (system:exit 0)))))
(= (irc:daemon)
   (if (irc:config-ok)
     (progn (irc:directories)
       (case (irc:lock "daemon.lock" exclusive-nowait)
         (((owned $owner) (irc:daemon-owned $owner)) (busy (system:exit 0)) ($bad (system:exit 2)))))
     (system:exit 2)))
!(if (is-member --irc-daemon (system:args)) (irc:daemon) ())
