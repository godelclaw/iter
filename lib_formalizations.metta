;; Extract text using erayindex's existing heuristics. This is not a MeTTa
;; parser or a proof checker, and extracted expressions are never evaluated.
!(import! &self "lib_context.metta")
(= (forms:depth $codes $depth $single)
   (if (== $codes ()) (== $depth 0)
     (let* ((($code $rest) (decons-atom $codes))
            ($next (+ $depth (if (== $code 40) 1 (if (== $code 41) -1 0)))))
       (if (and $single (and (== $code 41) (and (== $next 0) (not (== $rest ()))))) false
         (forms:depth $rest $next $single)))))
(= (forms:balanced $line) (forms:depth (str:python-codepoints $line) 0 false))
(= (forms:valid $line)
   (and (and (str:starts-with $line "(") (str:ends-with $line ")"))
        (and (not (ctx:contains $line "\"")) (forms:depth (str:python-codepoints $line) 0 true))))
(= (forms:default $line)
   (if (ctx:contains $line "(stv ") $line (str:join "" ("(" $line " (stv 1.0 0.5))"))))
(= (forms:stv-after $tail)
   (let $trimmed (text:lstrip $tail)
     (if (not (str:starts-with $trimmed "(")) NoSTV
       (let $body (str:byte-slice $trimmed 1 (str:byte-length $trimmed))
         (case (str:find $body ",")
           (((TextNotFound $missing) NoSTV)
            ($comma
             (if (== $comma 0) NoSTV
               (let $after (str:byte-slice $body (+ $comma 1) (str:byte-length $body))
                 (case (str:find $after ")")
                   (((TextNotFound $missing) NoSTV)
                    ($close (if (== $close 0) NoSTV
                              (STV (text:strip (str:byte-slice $body 0 $comma))
                                   (text:strip (str:byte-slice $after 0 $close))))))))))))))))
(= (forms:stv $line)
   (case (str:find $line "STV:")
     (((TextNotFound $missing) NoSTV)
      ($at (let $tail (str:byte-slice $line (+ $at 4) (str:byte-length $line))
             (case (forms:stv-after $tail)
               ((NoSTV (forms:stv $tail)) ($found $found))))))))
(= (forms:previous-stv $reversed $remaining)
   (if (or (== $reversed ()) (== $remaining 0)) NoSTV
     (let ($line $rest) (decons-atom $reversed)
       (if (ctx:contains $line "STV:") (forms:stv (text:strip $line))
         (forms:previous-stv $rest (- $remaining 1))))))
(= (forms:line $line $previous)
   (case (str:find $line "Formalization:")
     (((TextNotFound $missing) NoFormalization)
      ($at
       (let $form (text:strip (str:byte-slice $line (+ $at 14) (str:byte-length $line)))
         (if (not (forms:valid $form)) NoFormalization
           (let $wrapped (case (forms:previous-stv $previous 9)
                            (((STV $f $c) (str:join "" ("(" $form " (stv " $f " " $c "))")))
                             (NoSTV (forms:default $form))))
             (if (and (forms:balanced $wrapped) (not (ctx:contains $wrapped "\"")))
                 (Formalization $wrapped) NoFormalization))))))))
(= (forms:lines $lines $previous $reversed)
   (if (== $lines ()) (list:reverse $reversed)
     (let ($line $rest) (decons-atom $lines)
       (case (forms:line $line $previous)
         ((NoFormalization (forms:lines $rest (cons-atom $line $previous) $reversed))
          ((Formalization $form) (forms:lines $rest (cons-atom $line $previous) (cons-atom $form $reversed))))))))
(= (forms:message $message)
   (if (not (ctx:object $message)) (FormalizationsAbort "message must be an object")
     (let* (($raw (object-get $message "content" ""))
            ($content (if (== (object-get $message "role" JsonNull) "tool") (ctx:py-text $raw) $raw)))
       (if (is-string $content)
           (Formalizations (forms:lines (str:split "\n" $content) () ()))
           (if (case $content (((JsonArray $items) true) ((JsonObject $pairs) true) ($other false)))
               (if (case $content (((JsonArray $items) (is-member "Formalization:" $items))
                                  ((JsonObject $pairs) (is-member "Formalization:" (object-keys $content)))))
                   (FormalizationsAbort "content containing a formalization must be text") (Formalizations ()))
               (FormalizationsAbort "content is not searchable text"))))))
(= (forms:messages $messages $reversed)
   (if (== $messages ()) (Formalizations (list:reverse $reversed))
     (let ($message $rest) (decons-atom $messages)
       (case (forms:message $message)
         (((Formalizations $new) (forms:messages $rest (list:append (list:reverse $new) $reversed)))
          ($bad $bad))))))
(= (forms:existing $text)
   (map-atom (filter-atom (map-atom (str:split "\n" $text) $line (text:strip $line))
               $line (and (str:starts-with $line "(")
                          (and (not (ctx:contains $line "\"")) (forms:balanced $line))))
     $line (forms:default $line)))
(= (forms:write $path $fresh)
   (case (ctx:read $path)
     (((ContextText $text)
       (let $lines (first-n 500 (list:unique
                      (cons-atom ";; === Formalizations (auto-updated) ==="
                        (list:append $fresh (forms:existing $text)))))
         (case (fs:write $path (str:join "" (map-atom $lines $line (str:concat $line "\n"))))
           ((() true) ($failure (FormalizationsAbort "cannot write space text"))))))
      ($failure (FormalizationsAbort "cannot read space text")))))
(= (forms:transform $messages $tools $path)
   (if (not (fs:exists $path)) ($messages $tools)
     (case $messages
       (((JsonArray $items)
         (case (forms:messages $items ())
           (((Formalizations $fresh)
             (case (forms:write $path $fresh)
               ((true ($messages $tools))
                ((FormalizationsAbort $why) (Error "atom space update" $why)))))
            ((FormalizationsAbort $why) (Error "atom space update" $why)))))
        ($bad (Error "atom space update" "messages must be an array"))))))
